// Manage secrets on https://developer.mend.io/
{
  "hostRules": [
    {
      "hostType": "docker",
      "matchHost": "docker.io",
      "username": "{{ secrets.DOCKERHUB_USER }}",
      "password": "{{ secrets.DOCKERHUB_TOKEN }}"
    },
    {
      "hostType": "docker",
      "matchHost": "ghcr.io",
      "username": "{{ vars.GHCR_USER }}",
      "password": "{{ secrets.GHCR_TOKEN }}"
    }
  ]
}
